{
  "paper": "OpenVLA-2024-original",
  "implementation": "external_official",
  "dataset": {
    "format": "RLDS",
    "root": "data/bridge_rlds",
    "mixture": "bridge_orig",
    "instruction_required": true,
    "image_key": "image_primary",
    "action_dim": 7,
    "action_representation": "dataset_standardized_end_effector_delta_and_gripper",
    "normalization": "training_q01_q99",
    "normalization_mask": [true, true, true, true, true, true, false],
    "statistics_key": "bridge_orig"
  },
  "model": {
    "checkpoint": "openvla/openvla-7b",
    "vision": ["DINOv2", "SigLIP"],
    "image_size": 224,
    "tokenizer_edges": 256,
    "action_horizon": 1,
    "predict_stop_token": true
  },
  "training": {
    "route": "official_lora_finetuning",
    "all_parameter_training_alternative": true,
    "stats_from_train_split_only": true
  },
  "evaluation": {
    "offline": ["action_token_accuracy", "physical_action_error"],
    "rollout_route": "official_LIBERO_separate_finetuned_checkpoint",
    "rollout_metric": "task_success_rate"
  }
}
